# Másold .env néven, töltsd ki, majd: supabase secrets set --env-file .env
# A .env fájlt ne commitold.

# --- Supabase Edge Function secretek (csak szerveroldal) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_PREMIUM=price_xxx
# A Vercel domain gyökere, záró perjel nélkül
APP_URL=https://your-app.vercel.app

# --- Vercel környezeti változók (nyilvános, a böngészőben látható) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# A SUPABASE_URL, SUPABASE_ANON_KEY és SUPABASE_SERVICE_ROLE_KEY az Edge Functionök
# számára automatikusan elérhető, azokat ne add meg a secretek között.
# A számlázó (Billingo / Számlázz.hu) kulcsa még nem szükséges: a számlázás szimulált.
